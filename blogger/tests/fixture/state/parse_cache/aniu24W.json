ignals": []}, "1874408676465672": {"pub": "2026-08-25 06:22", "signals": [{"post_id": "1874408676465672", "pub": "2026-08-25 06:22", "d": 1, "spec": "t5", "idx": "上证指数", "quote": "昨天和今天大盘大概率见底"}, {"post_id": "1874408676465672", "pub": "2026-08-25 06:22", "d": 1, "spec": "t5", "idx": "科创50", "quote": "8.3号最低点1549是左底，昨天和今天大概率就是右底，后面就是新一波行情。"}]}, "1874385376645191": {"pub": "2026-08-24 14:34", "signals": [{"post_id": "1874385376645191", "pub": "2026-08-24 14:34", "d": 1, "spec": "t5", "idx": "上证指数", "quote": "大盘看4050"}, {"post_id": "1874385376645191", "pub": "2026-08-24 14:34", "d": 1, "spec": "t5", "idx": "科创50", "quote": "科创50先看上周二颈线1800，再看上方大的颈线1900。"}]}, "1874381140178120": {"pub": "2026-08-24 13:30", "signals": []}, "1874372478371976": {"pub": "2026-08-24 11:08", "signals": []}, "1874367801783300": {"pub": "2026-08-24 09:53", "signals": [{"post_id": "1874367801783300", "pub": "2026-08-24 09:53", "d": 1, "spec": "week", "idx": "科创50", "quote": "科创50，1600下方看机会"}, {"post_id": "1874367801783300", "pub": "2026-08-24 09:53", "d": 1, "spec": "week", "idx": "上证指数", "quote": "本周就是，遇到绿盘可以分批低吸"}]}, "1874280565599239": {"pub": "2026-08-23 10:47", "signals": [{"post_id": "1874280565599239", "pub": "2026-08-23 10:47", "d": 1, "spec": "nweek", "idx": "上证指数", "quote": "下周怎么做最好，就是遇到绿盘的时候，可以分批低吸"}]}, "1874110942311432": {"pub": "2026-08-21 13:51", "signals": [{"post_id": "1874110942311432", "pub": "2026-08-21 13:51", "d": -1, "spec": "t5", "idx": "上证指数", "quote": "大盘还是看3847附近"}, {"post_id": "1874110942311432", "pub": "2026-08-21 13:51", "d": -1, "spec": "t5", "idx": "科创50", "quote": "科创50看1600下方"}]}, "1874097979361288": {"pub": "2026-08-21 10:25", "signals": [{"post_id": "1874097979361288", "pub": "2026-08-21 10:25", "d": -1, "spec": "t5", "idx": "上证指数", "quote": "波段机会看3847附近"}, {"post_id": "1874097979361288", "pub": "2026-08-21 10:25", "d": -1, "spec": "t5", "idx": "科创50", "quote": "科创50波段机会还是看1600下方"}]}, "1874085069673479": {"pub": "2026-08-21 07:08", "signals": []}, "18740477777